{
  "name": "washbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vehicle wash & detailing operations platform for the Sri Lankan market",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . && knip",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:seed": "supabase db reset",
    "docker:up": "docker compose --env-file .env.local up -d --build",
    "docker:down": "docker compose --env-file .env.local down",
    "docker:logs": "docker compose --env-file .env.local logs -f",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "husky",
    "docker:build": "docker build --build-arg NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=local-build-check -t washbook:check .",
    "docker:dev": "docker compose --env-file .env.local -f docker-compose.dev.yml up"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,js,yml,yaml}": [
      "prettier --write"
    ],
    "*.sql": [
      "prettier --write --parser sql"
    ]
  }
}
