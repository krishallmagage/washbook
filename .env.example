# WashBook environment
#
# Copy to `.env.local` for local development. NEVER commit a real value —
# bootstrap brief §1.3 and §7. `.gitignore` blocks every .env file except this
# one, and CI checks the diff.
#
# Local values come from `pnpm db:start` (the Supabase CLI prints them).

# ---------------------------------------------------------------------------
# Supabase — public. These are inlined into the browser bundle by Next, so they
# must be safe to publish. The anon key is; the service-role key is NOT.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server only. This key bypasses Row Level Security, which is the
# tenancy boundary for the entire product (PRD §20). It must never appear in a
# client component, a NEXT_PUBLIC_ variable, or this repository.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Build metadata — injected by the Docker build, reported by /washbook/api/health
# ---------------------------------------------------------------------------
BUILD_SHA=development
