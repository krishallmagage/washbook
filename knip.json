{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,error,loading,not-found,global-error}.{ts,tsx}",
    "e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignoreDependencies": ["@tailwindcss/postcss", "tailwindcss"],
  "ignore": ["src/types/database.ts"]
}
